---
import '../styles/global.css';
import Header from '../components/Header.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
  // 'home' 不渲染顶栏，改为悬浮在右上角的主题切换
  // 'minimal' 渲染只有标记 + 主题切换的精简顶栏（用于 404 等独立页）
  variant?: 'home' | 'default' | 'minimal';
}

const {
  title = 'Lemon 的博客',
  description = 'Lemon 的个人技术博客 —— 写代码，也写一点关于代码和设计的笔记。',
  variant = 'default',
} = Astro.props;
---
<!doctype html>
<html lang="zh-Hans" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Noto+Serif+SC:wght@300;400;500;600&family=Noto+Sans+SC:wght@300;400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    {/* 首帧前同步主题，避免明暗闪烁 */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    {
      variant === 'home' ? (
        <div class="home-theme-toggle">
          <ThemeToggle />
        </div>
      ) : variant === 'minimal' ? (
        <div class="app shell">
          <header class="head">
            <a class="head-mark" href="/">Lemon</a>
            <ThemeToggle />
          </header>
        </div>
      ) : (
        <div class="app shell">
          <Header />
        </div>
      )
    }
    <slot />
  </body>
</html>
